{
  "AllowedHosts": "*",
  "App": {
    "PathBase": "/bmapp"
  },
  "ConnectionStrings": {
    "Bma": ""
  },
  "Database": {
    "MigrateOnStartup": true,
    "Deployment": "postgresql"
  },
  "Runtime": {
    "Mode": "process"
  },
  "Service": {
    "Name": "BMA Core"
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Jwt": {
    "Issuer": "BMA",
    "Audience": "BMA.Mobile",
    "SigningKey": "",
    "AccessMinutes": 15,
    "RefreshDays": 180
  },
  "Gateway": {
    "InboundKey": "",
    "ReconciliationEnabled": false,
    "BaseUrl": "https://gateway.abmtlab.com",
    "HistoryPath": "/api/bma/v1/integration-events",
    "HistoryKey": "",
    "IntervalSeconds": 60,
    "BatchSize": 100
  },
  "Plant": {
    "HeartbeatStaleSeconds": 90,
    "OutputStopGraceSeconds": 30
  },
  "Attendance": {
    "TimeZone": "Asia/Ho_Chi_Minh",
    "ShiftCode": "ADMIN",
    "ShiftName": "Ca Hành Chính",
    "ShiftStart": "07:00",
    "ShiftEnd": "17:00",
    "BreakStart": "11:00",
    "BreakEnd": "13:00",
    "EarlyEntryMinutes": 30,
    "LateExitMinutes": 20,
    "MissingPunchPercent": 50,
    "ReconciliationSeconds": 60
  },
  "TimeOfUse": {
    "RuleVersion": "VN-LEGACY-3-ZONE-V1",
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
