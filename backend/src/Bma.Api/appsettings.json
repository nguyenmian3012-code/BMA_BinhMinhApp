{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Bma": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "BMA",
    "Audience": "BMA.Mobile",
    "SigningKey": "",
    "AccessMinutes": 15,
    "RefreshDays": 180
  },
  "Gateway": {
    "InboundKey": "",
    "ReconciliationEnabled": false,
    "BaseUrl": "https://gateway.abmtlab.com",
    "HistoryPath": "/api/bma/v1/integration-events",
    "HistoryKey": "",
    "IntervalSeconds": 60,
    "BatchSize": 100
  },
  "Plant": {
    "HeartbeatStaleSeconds": 90,
    "OutputStopGraceSeconds": 30
  },
  "TimeOfUse": {
    "RuleVersion": "VN-LEGACY-3-ZONE-V1",
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
